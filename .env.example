# --- Local model (Ollama, OpenAI-compatible endpoint) ---
LOCAL_API_URL=http://localhost:11434/v1
LOCAL_API_KEY=ollama
MODEL_NAME=hf.co/bartowski/Qwen2.5-Coder-14B-Instruct-abliterated-GGUF:Q5_K_M

# --- Sandbox hardening ---
# Pinned to a digest by default (see agent_core.SANDBOX_IMAGE) so a repointed
# upstream tag can't silently change what runs in the sandbox. Override only
# if you rebuild/repin your own image.
# SANDBOX_IMAGE=python:3.11-alpine@sha256:...
SANDBOX_TIMEOUT=60
SANDBOX_MEM_LIMIT=256m
SANDBOX_PIDS_LIMIT=128
SANDBOX_CPU_QUOTA=50000
# bridge = isolated internet, none = no network
SANDBOX_NETWORK=bridge
SANDBOX_OUTPUT_LIMIT=20000

# --- Audit log rotation ---
AUDIT_LOG_MAX_BYTES=10485760
AUDIT_LOG_BACKUPS=5

# --- Agent behavior ---
MAX_HEAL_RETRIES=2

# --- Session encryption-at-rest (optional) ---
# Set any passphrase to encrypt new saved sessions/findings on disk (they may
# capture live recon data from real engagements). Unset = plaintext JSON.
# SESSIONS_KEY=change-me
